# ============================================================
# ADWP — Environment Variables
# Copy to .env.local and fill in real values
# ============================================================

# Database
DATABASE_URL="postgresql://adwp:adwp_dev_password@localhost:5433/adwp_dev"

# Redis
REDIS_URL="redis://:adwp_dev_password@localhost:6379"

# Kafka
KAFKA_BROKERS="localhost:9092"

# Auth (generate keys: openssl genrsa -out private.pem 2048)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
FIELD_ENCRYPTION_KEY=""  # generate: openssl rand -hex 32

# LLM Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_DEFAULT_PROVIDER="openai"
LLM_COST_BUDGET_MONTHLY_USD="100"

# Stripe (test mode)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@adwp.io"

# Platform
PLATFORM_URL="http://localhost:3000"
ENV="local"
TENANT_ISOLATION_MODE="rls"
