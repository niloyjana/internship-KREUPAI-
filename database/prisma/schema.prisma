model FinanceInvoice {
  id                  String   @id @default(cuid())
  tenantId            String
  vendorId            String?
  vendorName          String
  invoiceNumber       String
  invoiceDate         DateTime
  dueDate             DateTime?
  subtotal            Decimal
  taxAmount           Decimal  @default(0)
  totalAmount         Decimal
